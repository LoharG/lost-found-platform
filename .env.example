# Copy to .env (never commit it). docker compose reads it automatically.

# Required: openssl rand -hex 32
SESSION_SECRET=
# Postgres password for the local stack.
DB_PASSWORD=change-me-locally

# Public URL of the web app. Google/Apple callbacks default to
# ${APP_URL}/api/auth/<provider>/callback — register that exact URL.
APP_URL=http://localhost:3000

# Google OAuth (optional; login page explains when missing)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# Apple Sign in (optional)
# APPLE_CLIENT_ID=   APPLE_TEAM_ID=   APPLE_KEY_ID=
# APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# Email (local default: Mailpit at http://localhost:8025)
# SMTP_URL=smtp://user:pass@smtp.example.com:587
# MAIL_FROM="Lost & Found <no-reply@example.com>"

# Payments (₹100 connection fee). Default: local test provider (no real money).
# Razorpay test mode: PAYMENT_PROVIDER=razorpay plus keys from Dashboard > Test mode.
# Webhook URL: ${APP_URL}/api/payments/webhook  (events: payment.captured,
# payment.authorized, payment.failed, order.paid, refund.processed)
# PAYMENT_PROVIDER=razorpay
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
# RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxx
# RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxx

# Host ports (change API_HOST_PORT if macOS AirPlay Receiver uses 5000)
# APP_HOST_PORT=3000
# API_HOST_PORT=5000
# DB_HOST_PORT=5434
